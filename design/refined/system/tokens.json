{
  "name": "MANTIKA CHECK · Calibrated Paper v2",
  "color": {
    "ink": "#14213D",
    "paper": "#F6F3EC",
    "surface": "#FFFFFF",
    "surface.subtle": "#FAF8F3",
    "text.primary": "#14213D",
    "text.secondary": "#374151",
    "text.muted": "#4B5563",
    "border.rule": "#DDD6C6",
    "border.control": "#8C8574",
    "ok.text": "#2F4A39", "ok.bg": "#EAF0EA",
    "exp.text": "#6B4A12", "exp.bg": "#F3E6CC", "exp.line": "#B07A2A",
    "error.text": "#8E2F1C", "error.bg": "#FBEFE9",
    "neutral.bg": "#F1EEE6",
    "focus": "#B07A2A",
    "nav.bg": "#14213D", "nav.active": "#26365A", "nav.label": "#AEB8CB",
    "camera.bg": "#0E1626", "camera.panel": "#1C2638", "camera.warn": "#FFD58A"
  },
  "chart": {
    "series.160": {"color": "#7C8AA3", "marker": "circle"},
    "series.175": {"color": "#5D6B85", "marker": "square"},
    "series.190": {"color": "#3E4E6C", "marker": "triangle"},
    "series.205": {"color": "#253047", "marker": "diamond"},
    "series.220": {"color": "#14213D", "marker": "cross"},
    "measured": {"stroke": 2, "dash": "none", "marker": "filled"},
    "experimental": {"color": "#B07A2A", "stroke": 2, "dash": "6 4", "marker": "hollow"},
    "uncertainty": {"fill": "hatch 45deg #B07A2A"},
    "benchmark": {"color": "#374151", "stroke": 1.5, "dash": "2 4", "label": "25% research benchmark, not Philippine law"},
    "grid": "#EAE4D6", "axis": "#14213D", "tick.size": 13
  },
  "font": {
    "sans": "IBM Plex Sans, system-ui, sans-serif",
    "mono": "IBM Plex Mono, ui-monospace, monospace"
  },
  "type": {
    "display": {"size": 32, "weight": 600, "lineHeight": 1.15, "tracking": "-0.015em"},
    "title": {"size": 24, "weight": 600, "lineHeight": 1.2, "tracking": "-0.01em"},
    "heading": {"size": 20, "weight": 600, "lineHeight": 1.3},
    "body.mobile": {"size": 17, "weight": 400, "lineHeight": 1.5},
    "body.web": {"size": 15, "weight": 400, "lineHeight": 1.5},
    "label": {"size": 15, "weight": 600},
    "caption": {"size": 14, "weight": 400, "note": "minimum text size"},
    "data": {"family": "mono", "size": "inherit", "note": "numbers, units, IDs, file names only"}
  },
  "space": [4, 8, 12, 16, 24, 32, 48],
  "radius": {"small": 4, "large": 8},
  "border": {"default": 1, "emphasis": 2},
  "target": {"mobile.primary": 56, "mobile": 48, "web": 40, "gap": 8},
  "breakpoints": {"mobile": [320, 430], "tablet": 768, "desktop": [1024, 1440], "content.max": 1280},
  "grid": {
    "mobile": {"columns": 4, "margin": 16, "gutter": 12},
    "tablet": {"columns": 8, "margin": 32, "gutter": 16},
    "desktop": {"columns": 12, "margin": 40, "gutter": 24}
  },
  "motion": {"maxDuration": "200ms", "reduced": "none"}
}
